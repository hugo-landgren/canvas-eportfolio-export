# Canvas-instansens värdnamn, utan https://
CANVAS_HOST=canvas.example.edu

# Kontoadmin-token. Skapas under Konto -> Inställningar -> Ny åtkomsttoken.
# Behöver läsrätt på kontot; verktygen skriver aldrig något till Canvas.
CANVAS_API_TOKEN=

# Rotkontots id. Är nästan alltid 1, och används bara av --via-users.
CANVAS_ACCOUNT_ID=1
